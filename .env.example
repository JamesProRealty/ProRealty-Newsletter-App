# --- Server ---
PORT=3000
BASE_URL=https://your-domain.com
ADMIN_TOKEN=change-this-to-a-long-random-secret

# --- Zapier webhook auth ---
# Zapier will send this as a header: x-webhook-secret: <value>
ZAPIER_WEBHOOK_SECRET=change-this-to-a-long-random-secret

# --- Company info (required for CAN-SPAM / Australian Spam Act compliance) ---
COMPANY_NAME=Your Company Pty Ltd
COMPANY_ADDRESS=123 Example St, Adelaide SA 5000, Australia

# --- Email provider ---
# EMAIL_PROVIDER = "resend" or "smtp"
EMAIL_PROVIDER=resend

# Resend (https://resend.com) - recommended, simplest setup
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=newsletter@your-verified-domain.com
FROM_NAME=Your Company

# SMTP fallback (only used if EMAIL_PROVIDER=smtp) - e.g. Postmark, SES SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Sending throttle (ms delay between each send, avoid provider rate limits) ---
SEND_DELAY_MS=150

# --- Data directory (only needed on hosts with ephemeral filesystems, e.g. Railway) ---
# Point this at a mounted persistent volume so your contacts/campaigns survive redeploys.
# Leave unset to just use the local ./data folder (fine for your own server).
# DATA_DIR=/data
